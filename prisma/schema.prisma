// Prisma Schema - 技能评测系统数据模型 (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// 智能体管理（Skill Package 模式）
// ============================================

model Skill {
  id          String   @id @default(uuid())
  name        String
  description String?
  version     String   @default("1.0.0")
  category    String?  // 分类：function_call, rag, agent, chat, classification, summarization
  tags        String?  // 标签，逗号分隔
  // 新增：Package 支持
  parentId    String?  // 父技能ID，支持嵌套
  packageType String   @default("root") // root | sub_skill
  icon        String?  // 图标标识（emoji 或 icon name）
  // 保留字段
  instructions String? // 技能指令内容（SKILL.md 风格的 Markdown）
  allowedTools String? // 允许使用的工具列表，逗号分隔
  requiredContext String? // 需要的上下文信息，逗号分隔
  author      String?  // 技能作者
  license     String?  // 许可协议
  status      String   @default("active") // active, deprecated, draft
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 嵌套关系
  parent      Skill?   @relation("SkillNesting", fields: [parentId], references: [id], onDelete: Cascade)
  children    Skill[]  @relation("SkillNesting")
  // 文件树
  files       SkillFile[]
  // M:N 关联智能体（通过中间表）
  skillAgents SkillAgent[]
  // 评测 & 版本
  evalRuns    EvalRun[]
  skillVersions SkillVersion[]

  @@map("skills")
}

// 技能包文件（文件树管理）
model SkillFile {
  id        String   @id @default(uuid())
  skillId   String
  path      String   // 相对路径，如 "SKILL.md"、"prompts/main.md"
  content   String   // 文件内容
  fileType  String   // markdown, json, yaml, text, python, javascript
  size      Int      @default(0) // 文件大小（字节）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, path])
  @@map("skill_files")
}

// 技能-智能体关联中间表（M:N）
model SkillAgent {
  id         String   @id @default(uuid())
  skillId    String
  endpointId String
  role       String   @default("primary") // primary | fallback | observer
  config     String?  // 关联配置 JSON
  createdAt  DateTime @default(now())

  skill      Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  endpoint   AgentEndpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([skillId, endpointId])
  @@map("skill_agents")
}

model AgentEndpoint {
  id             String   @id @default(uuid())
  name           String
  description    String?  // 智能体描述
  url            String
  model          String?  // 底层模型，如 gpt-4, claude-3, qwen-max
  systemPrompt   String?  // 系统提示词
  status         String   @default("active") // active, inactive, error
  authType       String   @default("none") // none, api_key, oauth, token
  authConfig     String?  // 认证配置（JSON字符串，加密存储）
  sseFormat      String   @default("auto") // auto, content, delta, custom
  sseTemplate    String?  // SSE 响应解析模板（JSON字符串）
  requestTemplate String? // 请求体模板（JSON字符串）
  timeout        Int      @default(30000)  // 超时时间(ms)
  maxRetries     Int      @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // M:N 关联技能（通过中间表）
  skillAgents    SkillAgent[]
  evalRuns       EvalRun[]

  @@map("agent_endpoints")
}

model SkillVersion {
  id          String   @id @default(uuid())
  skillId     String
  version     String
  snapshot    String   // 版本快照数据（JSON字符串）
  createdAt   DateTime @default(now())

  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@map("skill_versions")
}

// ============================================
// 评测数据集
// ============================================

model Dataset {
  id               String   @id @default(uuid())
  name             String
  description      String?
  category         String?  // 分类标签
  validationStatus String   @default("draft") // draft, validating, validated, rejected
  validationReport String?  // 验证报告 JSON
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  testCases        TestCase[]
  snapshots        DatasetSnapshot[]

  @@map("datasets")
}

model TestCase {
  id            String   @id @default(uuid())
  datasetId     String
  input         String   // 输入 prompt/上下文
  expectedOutput String? // 期望输出
  difficulty    String   @default("medium") // easy, medium, hard
  tags          String   @default("") // 评测维度标签，逗号分隔
  metadata      String?  // 额外元数据（JSON字符串）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dataset       Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  evalResults   EvalResult[]
  generationRecords GenerationRecord[]

  @@map("test_cases")
}

model DatasetSnapshot {
  id          String   @id @default(uuid())
  datasetId   String
  version     String
  data        String   // 快照数据（JSON字符串）
  createdAt   DateTime @default(now())

  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, version])
  @@map("dataset_snapshots")
}

// 评测集 AI 生成记录
model GenerationRecord {
  id            String   @id @default(uuid())
  testCaseId    String
  input         String   // 原始问题
  candidates    String   // 3个候选答案（JSON字符串）
  aiRecommendation Int?  // AI推荐的答案索引
  selectedIndex Int?     // 人工选择的索引
  finalOutput   String?  // 最终确认的标准答案
  createdAt     DateTime @default(now())

  testCase      TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@map("generation_records")
}

// ============================================
// 评测执行
// ============================================

model EvalRun {
  id            String   @id @default(uuid())
  skillId       String
  endpointId    String
  datasetId     String?  // 可选，关联数据集
  status        String   @default("pending") // pending, running, completed, failed
  config        String?  // 运行配置（JSON字符串）
  startTime     DateTime?
  endTime       DateTime?
  totalCases    Int      @default(0)
  passedCases   Int      @default(0)
  failedCases   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  skill         Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  endpoint      AgentEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  results       EvalResult[]
  pipeline      PipelineInstance?

  @@map("eval_runs")
}

model EvalResult {
  id            String   @id @default(uuid())
  evalRunId     String
  testCaseId    String
  status        String   @default("pending") // pending, passed, failed, error
  actualOutput  String?  // 实际输出
  rawSseStream  String?  // 原始 SSE 流数据
  metrics       String?  // 性能指标（JSON字符串：耗时、token等）
  scores        String?  // 各维度评分（JSON字符串）
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evalRun       EvalRun  @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  testCase      TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  annotations   Annotation[]

  @@map("eval_results")
}

// ============================================
// 标注体系
// ============================================

model Annotation {
  id            String    @id @default(uuid())
  evalResultId  String
  taskId        String?   // 关联标注任务（批量自动标注时写入）
  type          String   // ai, human
  annotatorId   String?  // 标注员ID（人工标注时）
  scores        String   // 评分数据（JSON字符串）
  comment       String?  // 批注
  status        String    @default("pending") // pending, approved, rejected, modified, conflict
  confidence    Float?    // AI 标注置信度（0-1）
  modelVersion  String?   // AI 标注使用的模型标识
  reviewedBy    String?   // 审核人
  reviewedAt    DateTime? // 审核时间
  isFinal       Boolean  @default(false) // 是否为最终标注
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evalResult    EvalResult      @relation(fields: [evalResultId], references: [id], onDelete: Cascade)
  task          AnnotationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("annotations")
}

model AnnotationTask {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   @default("eval_review") // eval_review=评测结果审核, classification/ner/... =辅助标注
  status      String   @default("pending") // pending, in_progress, completed, archived
  evalRunId   String?
  createdBy   String?
  assignees   String?  // JSON 字符串数组
  config      String?  // 任务配置（JSON字符串：labels/guidelines等）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  annotations Annotation[]
  items       AnnotationItem[]

  @@map("annotation_tasks")
}

model AnnotationItem {
  id            String   @id @default(uuid())
  taskId        String
  input         String
  context       String?
  preAnnotation String?  // 预标注建议（JSON字符串）
  annotation    String?  // 人工标注结果（JSON字符串）
  status        String   @default("pending") // pending, annotated, reviewed, rejected
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  task          AnnotationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("annotation_items")
}

// ============================================
// AI 修复
// ============================================

model FixRecord {
  id            String   @id @default(uuid())
  evalResultId  String
  diagnosis     String   // 问题诊断
  suggestion    String   // 修复建议
  fixType       String   // prompt, knowledge, parameter
  fixContent    String?  // 修复内容（JSON字符串）
  appliedAt     DateTime? // 应用时间
  verified      Boolean  @default(false) // 是否验证通过
  createdAt     DateTime @default(now())

  @@map("fix_records")
}

// ============================================
// 流水线编排
// ============================================

model Pipeline {
  id            String   @id @default(uuid())
  name          String
  description   String?
  template      String   // 流水线节点定义（JSON字符串）
  isPreset      Boolean  @default(false) // 是否预置模板
  cronExpression String? // 定时表达式
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instances     PipelineInstance[]

  @@map("pipelines")
}

model PipelineInstance {
  id            String   @id @default(uuid())
  pipelineId    String
  evalRunId     String?  @unique // 一对一关系需要 @unique
  status        String   @default("pending") // pending, running, completed, failed
  currentNode   String?
  progress      String?  // 各节点进度（JSON字符串）
  startTime     DateTime?
  endTime       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pipeline      Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  evalRun       EvalRun? @relation(fields: [evalRunId], references: [id], onDelete: SetNull)

  @@map("pipeline_instances")
}

// ============================================
// 告警配置
// ============================================

model AlertConfig {
  id                String   @id @default(uuid())
  channel           String   @default("wechat") // wechat
  webhookKey        String
  passRateThreshold Float    @default(80.0) // 通过率阈值(%)
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("alert_configs")
}
